# Copy to `.env` for local `pnpm dev` against docker-compose.dev.yml:
#
#   docker compose -f docker-compose.dev.yml up -d
#   cp .env.dev .env
#   # then fill AUTH_SECRET, OAuth, AUTH_EMAIL_FROM
#
# The app runs on the host; only Postgres and RustFS run in Docker.
# Hostnames are localhost (published ports), not the compose service names.

# Matches docker-compose.dev.yml defaults: user/password/db = con_carino,
# Postgres published at localhost:5432.
POSTGRES_USER="con_carino"
POSTGRES_PASSWORD="con_carino"
POSTGRES_DB="con_carino"
DATABASE_URL="postgresql://con_carino:con_carino@localhost:5432/con_carino?schema=public"

# Auth.js — omit AUTH_URL locally (trustHost is on; the request host is used).
# If you set it, the path must be included or login fails with UnknownAction:
# AUTH_URL="http://localhost:3000/api/auth"
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Required at boot. onboarding@resend.dev only delivers to your Resend account email.
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM=""

# Unset in local dev: POST /api/jobs is open on localhost.
JOB_SECRET=""

# Matches docker-compose.dev.yml RustFS (API :9000, console :9001).
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="rustfsadmin"
S3_SECRET_ACCESS_KEY="rustfsadmin"
S3_BUCKET="con-carino"
S3_FORCE_PATH_STYLE="true"
