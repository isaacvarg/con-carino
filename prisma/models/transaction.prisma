/// Which way a type moves an account balance. This, not the type itself, is
/// what the sign logic switches on — so adding a type is data, not a migration.
enum TransactionSign {
  NEGATIVE
  POSITIVE
  /// Asks at entry time (Transfer, Balance adjustment). Reserved for the two
  /// built-ins; admin-created types are NEGATIVE or POSITIVE.
  DIRECTIONAL
}

/// Was a Prisma enum. Now a table so admins can add and rename types.
///
/// `sign` may only change while nothing references the row: amounts are stored
/// already-signed, so flipping the sign under existing transactions would
/// invert their meaning without touching their values.
model TransactionTypeDef {
  id         String          @id @default(uuid())
  /// Stable code identifier, uppercase snake. Immutable once created — app
  /// code references the built-in keys directly.
  key        String          @unique
  label      String
  sign       TransactionSign
  /// The eight original enum members. Label and order stay editable; sign is
  /// frozen and hard delete is refused.
  isSystem   Boolean         @default(false)
  sortOrder  Int
  archivedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  transactions Transaction[]
  automations  Automation[]

  @@index([archivedAt])
  @@map("transaction_types")
}

enum ReconciliationStatus {
  UNCLEARED
  CLEARED
  NEEDS_REVIEW
  RECONCILED
}

model Transaction {
  id                 String          @id @default(uuid())
  userId             String
  financialAccountId String
  typeId             String
  amount             Decimal         @db.Decimal(19, 4)
  description        String?
  payeeId            String?
  categoryId         String?
  date               DateTime
  // Links the two paired rows that make up a single transfer.
  transferGroupId    String?
  reconciliationStatus      ReconciliationStatus @default(UNCLEARED)
  reconciliationUpdatedAt   DateTime?
  reconciliationUpdatedById String?
  // Set when an automation wrote this row. Its presence is what stops an
  // automation's output from triggering another automation.
  createdByAutomationId     String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user                    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialAccount        FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: a type in use must be archived, never deleted out
  // from under the transactions that carry it.
  type                    TransactionTypeDef @relation(fields: [typeId], references: [id], onDelete: Restrict)
  payee                   Payee?           @relation(fields: [payeeId], references: [id], onDelete: SetNull)
  category                Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reconciliationUpdatedBy User?            @relation("TransactionReconciliationUpdatedBy", fields: [reconciliationUpdatedById], references: [id], onDelete: SetNull)
  createdByAutomation     Automation?      @relation("TransactionCreatedByAutomation", fields: [createdByAutomationId], references: [id], onDelete: SetNull)
  automationRunsAsSource  AutomationRun[]  @relation("AutomationRunSource")
  automationRunAsCreated  AutomationRun?   @relation("AutomationRunCreated")
  tags                    Tag[]
  attachments             Attachment[]
  careInvoice             CareInvoice?
  careLedgerEntry         CareContributionLedgerEntry?

  @@index([userId, date])
  @@index([typeId])
  @@index([financialAccountId, date])
  @@index([financialAccountId, reconciliationStatus])
  @@index([payeeId])
  @@index([categoryId])
  @@index([transferGroupId])
  @@index([reconciliationUpdatedById])
  @@index([createdByAutomationId])
  @@map("transactions")
}
