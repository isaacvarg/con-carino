model Tag {
  id        String   @id @default(uuid())
  name      String
  iconId    String?
  bgColor   String?
  textColor String?
  /// Set when an admin archived this tag: hidden from every picker and list,
  /// but still resolved on the transactions that already carry it. Archiving
  /// hides a thing from future choices; it does not rewrite history.
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  automations  Automation[]

  @@index([archivedAt])
  @@map("tags")
}
