enum AccountType {
  CHECKING
  CREDIT_CARD
  SAVINGS
  LOAN
  CASH
  INVESTMENT
  VIRTUAL
}

model AccountGroup {
  id        String   @id @default(uuid())
  userId    String
  name      String
  isGlobal  Boolean  @default(false)
  /// See `Tag.archivedAt` — hidden from pickers, still resolved on history.
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts FinancialAccount[]

  @@index([userId])
  @@index([archivedAt])
  @@map("account_groups")
}

model FinancialAccount {
  id             String      @id @default(uuid())
  userId         String
  name           String
  type           AccountType
  accountGroupId String?
  initialBalance Decimal     @default(0) @db.Decimal(19, 4)
  isGlobal       Boolean     @default(false)
  /// See `Tag.archivedAt`. An archived account keeps its transactions and still
  /// contributes to history, but is hidden from account lists and pickers.
  archivedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountGroup AccountGroup? @relation(fields: [accountGroupId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  careInvoices CareInvoice[]
  careSettings         CareSettings[]            @relation("CareCoverageAccount")
  contributionProfiles CareContributionProfile[]
  automationTriggers   Automation[]              @relation("AutomationTriggerAccount")
  automationTargets    Automation[]              @relation("AutomationTargetAccount")

  @@index([userId])
  @@index([accountGroupId])
  @@index([archivedAt])
  @@map("financial_accounts")
}
