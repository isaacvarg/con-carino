enum CareCoverageFrequency {
  WEEKLY
  BIWEEKLY
}

enum CareCoverageNeed {
  FULL
  PARTIAL
}

enum CareCoverageWindowKind {
  ALL_DAY
  SHIFTS
}

/// How much of the invoicing module this install runs.
enum CareInvoicingMode {
  /// Hidden entirely. No invoices are generated.
  OFF
  /// Read-only pay overview per week or month. Nothing is generated or settled.
  SIMPLE
  /// Period invoices, settlement, and voiding.
  ADVANCED
}

enum CareOccurrenceStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CareSwapStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CareSwapItemRole {
  /// Currently the target person's window; moves to the requester person
  TAKE
  /// Currently the requester person's window; moves to the target person
  GIVE
}

enum CareInvoiceStatus {
  OPEN
  PAID
  VOID
}

enum CarePayInterval {
  PER_SHIFT
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum CareRateType {
  HOURLY
  DAILY
}

/// Which of a person's two rates a priced segment was charged at.
enum CareRateBand {
  STANDARD
  OFF_SCHEDULE
}

enum CareBillingStatus {
  NOT_BILLABLE
  ACCRUED
  INVOICED
}

enum CareAssignmentScope {
  ALL_SHIFTS
  SPECIFIC_SHIFTS
}

enum CareContributionBasis {
  PERCENT
  FIXED
}

/// How to reconcile contributions when fixed amounts and percentages do not
/// add up to the period total.
enum CareSplitPolicy {
  /// Fixed pledges come off the top; percentage contributors split the rest,
  /// renormalised against each other so the pool is always fully covered.
  FIXED_FIRST_THEN_PERCENT
  /// Percentages and fixed amounts apply literally; one nominated person
  /// absorbs whatever is left over or short.
  BACKSTOP
}

enum CareContributionCadence {
  WEEKLY
  EVERY_N_WEEKS
  MONTHLY
}

enum CareContributionStatus {
  /// Raised and waiting on a human; writes nothing to the ledger.
  PROPOSED
  /// Transfer created; a matching CONTRIBUTION ledger entry exists.
  POSTED
  SKIPPED
  CANCELLED
}

enum CareFundingPeriodStatus {
  OPEN
  CLOSED
}

enum CareLedgerEntryKind {
  /// What a person owed for a closed period.
  CHARGE
  /// Money they actually moved into the pot.
  CONTRIBUTION
  /// Correction after a period was re-closed with different actuals.
  TRUE_UP
  /// Manual correction by a person.
  ADJUSTMENT
}

/// A person's standing agreement to fund care.
model CareContributionProfile {
  id               String                  @id @default(uuid())
  carePersonId     String                  @unique
  basis            CareContributionBasis   @default(PERCENT)
  /// 0–100. 6dp so an awkward split like 33.333333% renormalises cleanly.
  percent          Decimal?                @db.Decimal(9, 6)
  fixedAmount      Decimal?                @db.Decimal(19, 4)
  /// Account their contribution transfers out of. Null for someone who
  /// contributes but has no account in this app.
  fundingAccountId String?
  cadence          CareContributionCadence @default(MONTHLY)
  /// Used with EVERY_N_WEEKS; WEEKLY is simply intervalWeeks = 1.
  intervalWeeks    Int                     @default(1)
  /// Anchors the EVERY_N_WEEKS cycle.
  anchorDate       DateTime?               @db.Date
  /// 1–28, used with MONTHLY.
  monthDay         Int?
  /// Create the transfer automatically, or propose it for one-click confirm.
  autoPost         Boolean                 @default(false)
  isActive         Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  carePerson     CarePerson        @relation(fields: [carePersonId], references: [id], onDelete: Cascade)
  fundingAccount FinancialAccount? @relation(fields: [fundingAccountId], references: [id], onDelete: SetNull)

  @@index([fundingAccountId])
  @@map("care_contribution_profiles")
}

/// One budgeting window. Opens with a planned budget, closes on real cost.
model CareFundingPeriod {
  id            String                  @id @default(uuid())
  periodStart   DateTime                @db.Date
  /// Inclusive.
  periodEnd     DateTime                @db.Date
  plannedBudget Decimal                 @db.Decimal(19, 4)
  /// Real invoiced cost, computed at close.
  actualCost    Decimal?                @db.Decimal(19, 4)
  status        CareFundingPeriodStatus @default(OPEN)
  closedAt      DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  entries CareContributionLedgerEntry[]

  @@unique([periodStart])
  @@index([status, periodEnd])
  @@map("care_funding_periods")
}

/// Append-only. A person's running balance is exactly SUM(amount) over their
/// entries — nothing is cached and nothing is derived twice.
/// Positive means they owe the pot; negative means the pot owes them.
model CareContributionLedgerEntry {
  id                      String              @id @default(uuid())
  carePersonId            String
  fundingPeriodId         String?
  kind                    CareLedgerEntryKind
  amount                  Decimal             @db.Decimal(19, 4)
  description             String
  scheduledContributionId String?             @unique
  /// The inbound (coverage-account) leg of the posted transfer.
  transactionId           String?             @unique
  createdByUserId         String?
  createdAt               DateTime            @default(now())

  carePerson            CarePerson                 @relation(fields: [carePersonId], references: [id], onDelete: Restrict)
  fundingPeriod         CareFundingPeriod?         @relation(fields: [fundingPeriodId], references: [id], onDelete: SetNull)
  scheduledContribution CareScheduledContribution? @relation(fields: [scheduledContributionId], references: [id], onDelete: SetNull)
  transaction           Transaction?               @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdByUser         User?                      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  /// NOTE: a partial unique index enforcing one CHARGE per person per period
  /// is created by hand in the migration. Do not promote this to @@unique —
  /// Prisma would generate a full unique index and the two would conflict on
  /// every `migrate dev`.
  @@index([fundingPeriodId, carePersonId])
  @@index([carePersonId, createdAt])
  @@map("care_contribution_ledger_entries")
}

/// A due (or already made) transfer into the coverage pot.
model CareScheduledContribution {
  id                       String                 @id @default(uuid())
  carePersonId             String
  dueOn                    DateTime               @db.Date
  /// Share of the planned budget under the split policy, pro-rated to cadence.
  baseAmount               Decimal                @db.Decimal(19, 4)
  /// Running balance snapshotted when this row was generated.
  carriedBalance           Decimal                @db.Decimal(19, 4)
  /// max(0, baseAmount + carriedBalance) — the figure actually transferred.
  /// Snapshotted rather than recomputed on view so the number in a confirm
  /// dialog cannot shift between render and click.
  amount                   Decimal                @db.Decimal(19, 4)
  status                   CareContributionStatus @default(PROPOSED)
  fundingAccountIdSnapshot String?
  transferGroupId          String?
  postedAt                 DateTime?
  postedByUserId           String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  carePerson   CarePerson                   @relation(fields: [carePersonId], references: [id], onDelete: Cascade)
  postedByUser User?                        @relation(fields: [postedByUserId], references: [id], onDelete: SetNull)
  ledgerEntry  CareContributionLedgerEntry?

  @@unique([carePersonId, dueOn])
  @@index([status, dueOn])
  @@index([transferGroupId])
  @@map("care_scheduled_contributions")
}

/// Singleton settings for the one loved one on this app instance.
model CareSettings {
  id                   String                 @id @default("default")
  lovedOneName         String                 @default("")
  coverageNeed         CareCoverageNeed       @default(FULL)
  coverageWindowKind   CareCoverageWindowKind @default(ALL_DAY)
  /// Days of week 0=Sun … 6=Sat; used when coverageNeed is PARTIAL
  partialDaysOfWeek    Int[]                  @default([])
  /// The joint "coverage pot": contributions transfer in, invoices settle out.
  coverageAccountId    String?
  splitPolicy          CareSplitPolicy        @default(FIXED_FIRST_THEN_PERCENT)
  /// Absorbs the remainder when splitPolicy is BACKSTOP.
  backstopPersonId     String?
  /// Planned care spend per funding period; sizes the recurring transfers.
  plannedMonthlyBudget Decimal?               @db.Decimal(19, 4)
  /// 1–28: day of month a funding period starts.
  fundingPeriodDay     Int                    @default(1)
  /// Which modules this family runs. Invoices and contributions are the two
  /// heaviest features here and are noise for a family that only wants the
  /// coverage calendar.
  invoicingMode        CareInvoicingMode      @default(ADVANCED)
  /// Only meaningful with ADVANCED invoicing: a period's actual cost is summed
  /// from real invoice rows, which SIMPLE and OFF never create.
  contributionsEnabled Boolean                @default(true)
  /// 0=Sun or 1=Mon: which day a *displayed* week starts on, app-wide — the
  /// calendar grid, the pay overview, and the week filed on a transaction. Lives
  /// here because this row is already the household's settings, even though it
  /// reaches well beyond care. Same 0=Sun … 6=Sat convention as the fields
  /// above, but unlike them it is a display choice, not stored data: changing it
  /// must never reinterpret a persisted day-of-week value.
  weekStartsOn         Int                    @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  shifts CareRequiredShift[]
  /// SetNull, not Restrict: deleting the pot account should blank this field
  /// rather than make the account undeletable.
  coverageAccount FinancialAccount? @relation("CareCoverageAccount", fields: [coverageAccountId], references: [id], onDelete: SetNull)
  backstopPerson  CarePerson?       @relation("SettingsBackstop", fields: [backstopPersonId], references: [id], onDelete: SetNull)

  @@map("care_settings")
}

model CareRequiredShift {
  id         String   @id @default(uuid())
  settingsId String   @default("default")
  label      String?
  /// Local wall time "HH:mm"
  startTime  String
  /// Local wall time "HH:mm"
  endTime    String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  settings CareSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  requiredSeries CareCoverageSeries[]

  @@index([settingsId, sortOrder])
  @@map("care_required_shifts")
}

model CarePersonType {
  id         String   @id @default(uuid())
  name       String   @unique
  isPaid     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  people CarePerson[]

  @@map("care_person_types")
}

model CarePerson {
  id            String          @id @default(uuid())
  name          String
  userId        String?         @unique
  typeId        String
  hourlyRate    Decimal?        @db.Decimal(19, 4)
  /// Whether hourlyRate is charged per hour or as a flat daily amount
  rateType      CareRateType    @default(HOURLY)
  /// When true and rateType is DAILY, bill the full daily rate per calendar day
  /// covered, regardless of hours actually worked in the window
  flatDailyRate Boolean         @default(false)
  /// When to create period invoices; only applies when type.isPaid
  payInterval   CarePayInterval @default(PER_SHIFT)
  /// 0=Sun … 6=Sat; used for WEEKLY / BIWEEKLY
  payWeekday    Int?
  /// Known payday date; anchors BIWEEKLY alignment
  payAnchorDate DateTime?       @db.Date
  /// 1–28; used for MONTHLY
  payMonthDay   Int?
  /// Typical working schedule, 0=Sun … 6=Sat. Empty means no schedule is
  /// configured, which makes every window bill at the standard rate.
  /// Rate classification only — recurring assignment is still driven by
  /// CareCoverageAssignmentRule, so a person can be regularly assigned to a
  /// day that bills off-schedule.
  standardDaysOfWeek Int[]      @default([])
  /// Local wall time "HH:mm" bounding the standard part of a standard day.
  /// Both null = the whole of a standard day is standard. An end at or before
  /// the start means the window runs overnight into the next day.
  standardStartTime  String?
  standardEndTime    String?
  /// Rate for work outside the typical schedule. Uses the same rateType and
  /// flatDailyRate as hourlyRate — only the amount differs. Null means no
  /// premium, so everything bills at the standard rate.
  offScheduleRate    Decimal?   @db.Decimal(19, 4)
  /// Still on the roster, just not currently being scheduled. Shows an
  /// "Inactive" badge in the People list and is filtered out of assignment
  /// pickers — deliberately distinct from `archivedAt` below.
  isActive      Boolean         @default(true)
  /// Removed. Hidden everywhere including the People list, and visible only
  /// under Settings → Archived. See `Tag.archivedAt`.
  archivedAt    DateTime?
  bgColor       String?
  textColor     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  type          CarePersonType            @relation(fields: [typeId], references: [id], onDelete: Restrict)
  series        CareCoverageSeries[]
  occurrences   CareCoverageOccurrence[]  @relation("OccurrenceAssignee")
  releasedOccurrences CareCoverageOccurrence[] @relation("OccurrenceReleasedBy")
  responsibleOccurrences CareCoverageOccurrence[] @relation("OccurrenceResponsible")
  contributionProfile    CareContributionProfile?
  ledgerEntries          CareContributionLedgerEntry[]
  scheduledContributions CareScheduledContribution[]
  backstopForSettings    CareSettings[]           @relation("SettingsBackstop")
  assignmentRules CareCoverageAssignmentRule[]
  swapsRequested CareSwapRequest[]        @relation("SwapRequesterPerson")
  swapsTargeted  CareSwapRequest[]        @relation("SwapTargetPerson")
  invoices      CareInvoice[]

  @@index([typeId])
  @@index([archivedAt])
  @@map("care_people")
}

model CareCoverageSeries {
  id               String                 @id @default(uuid())
  assigneeId       String?
  startsOn         DateTime               @db.Date
  endsOn           DateTime?              @db.Date
  /// Local wall time "HH:mm"
  startTime        String
  /// Local wall time "HH:mm"
  endTime          String
  frequency        CareCoverageFrequency
  /// Days of week 0=Sun … 6=Sat
  daysOfWeek       Int[]
  notes            String?
  /// System series produced from loved-one required coverage settings
  isRequired       Boolean                @default(false)
  requiredKey      String?
  /// Stable required-shift identity for SHIFTS windows; null for ALL_DAY/manual
  requiredShiftId  String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  assignee    CarePerson?              @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  requiredShift CareRequiredShift?     @relation(fields: [requiredShiftId], references: [id], onDelete: SetNull)
  occurrences CareCoverageOccurrence[]

  @@index([assigneeId])
  @@index([isRequired])
  @@index([requiredShiftId])
  @@unique([requiredKey])
  @@map("care_coverage_series")
}

model CareCoverageOccurrence {
  id            String                @id @default(uuid())
  seriesId      String?
  assigneeId    String?
  /// Set when an assignment rule auto-filled this slot; enables clean revert
  assignedByRuleId String?
  startsAt      DateTime
  endsAt        DateTime
  status        CareOccurrenceStatus  @default(SCHEDULED)
  billingStatus CareBillingStatus     @default(NOT_BILLABLE)
  notes         String?
  /// Set when the assignee removed themselves from this slot; suppresses
  /// auto-refill by that same person's assignment rules. Cleared on any assign.
  releasedByPersonId String?
  releasedAt         DateTime?
  /// Sole responsibility: this person owes 100% of this window's cost, carved
  /// out of the shared pool before contribution percentages are applied. Set
  /// when someone hires paid help to cover a window that was theirs.
  ///
  /// Distinct from releasedByPersonId — giving a window back to the pool costs
  /// you nothing, hiring someone to cover it makes it entirely yours.
  responsiblePersonId    String?
  responsibleSetAt       DateTime?
  responsibleSetByUserId String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  series           CareCoverageSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  assignee         CarePerson?         @relation("OccurrenceAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  releasedBy       CarePerson?         @relation("OccurrenceReleasedBy", fields: [releasedByPersonId], references: [id], onDelete: SetNull)
  responsiblePerson CarePerson?        @relation("OccurrenceResponsible", fields: [responsiblePersonId], references: [id], onDelete: SetNull)
  assignedByRule   CareCoverageAssignmentRule? @relation(fields: [assignedByRuleId], references: [id], onDelete: SetNull)
  invoiceLines     CareInvoiceLine[]
  swapItems        CareSwapItem[]

  @@unique([seriesId, startsAt])
  @@index([startsAt, endsAt])
  @@index([assigneeId])
  @@index([releasedByPersonId])
  @@index([responsiblePersonId])
  @@index([assignedByRuleId])
  @@index([status])
  @@index([billingStatus])
  @@map("care_coverage_occurrences")
}

/// Persistent rule that assigns a person to required coverage on a recurring
/// (weekly) basis. Fills open required occurrences matching its days and shift
/// scope, at creation and as future occurrences materialize.
model CareCoverageAssignmentRule {
  id         String              @id @default(uuid())
  assigneeId String
  startsOn   DateTime            @db.Date
  /// null = indefinite
  endsOn     DateTime?           @db.Date
  /// Days of week 0=Sun … 6=Sat
  daysOfWeek Int[]
  /// Cadence in weeks: 1 = weekly, 2 = every other week, etc. Anchored at startsOn.
  intervalWeeks Int              @default(1)
  scope      CareAssignmentScope @default(ALL_SHIFTS)
  /// Targeted CareRequiredShift ids when scope is SPECIFIC_SHIFTS
  shiftIds   String[]            @default([])
  notes      String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  assignee    CarePerson               @relation(fields: [assigneeId], references: [id], onDelete: Cascade)
  occurrences CareCoverageOccurrence[]

  @@index([assigneeId])
  @@map("care_coverage_assignment_rules")
}

/// User-managed category for calendar events, controlling how the event
/// appears on the calendar (background and text color).
model CareEventType {
  id        String   @id @default(uuid())
  name      String   @unique
  bgColor   String
  textColor String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events CareCalendarEvent[]

  @@map("care_event_types")
}

model CareCalendarEvent {
  id        String   @id @default(uuid())
  typeId    String
  title     String
  startsAt  DateTime
  endsAt    DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type CareEventType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@index([typeId])
  @@index([startsAt, endsAt])
  @@map("care_calendar_events")
}

/// A negotiation between two people: the requester takes one or more windows
/// currently assigned to the target person, and optionally gives some of their
/// own windows back. Open (unassigned) windows are never part of a swap — those
/// are handled by the no-approval claim flow.
model CareSwapRequest {
  id                String         @id @default(uuid())
  /// Person receiving the TAKE windows; usually the requester's linked person
  requesterPersonId String
  /// Person losing the TAKE windows
  targetPersonId    String
  requestedByUserId String
  status            CareSwapStatus @default(PENDING)
  reviewedByUserId  String?
  reviewedAt        DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  requesterPerson CarePerson @relation("SwapRequesterPerson", fields: [requesterPersonId], references: [id], onDelete: Restrict)
  targetPerson    CarePerson @relation("SwapTargetPerson", fields: [targetPersonId], references: [id], onDelete: Restrict)
  requestedByUser User       @relation("SwapRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  reviewedByUser  User?      @relation("SwapReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  items           CareSwapItem[]

  @@index([status])
  @@index([targetPersonId, status])
  @@index([requestedByUserId])
  @@map("care_swap_requests")
}

model CareSwapItem {
  id           String           @id @default(uuid())
  swapId       String
  occurrenceId String
  role         CareSwapItemRole

  swap       CareSwapRequest        @relation(fields: [swapId], references: [id], onDelete: Cascade)
  occurrence CareCoverageOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@unique([swapId, occurrenceId])
  @@index([occurrenceId])
  @@map("care_swap_items")
}

model CareInvoice {
  id                   String            @id @default(uuid())
  carePersonId         String
  amount               Decimal           @db.Decimal(19, 4)
  status               CareInvoiceStatus @default(OPEN)
  periodStart          DateTime?
  periodEnd            DateTime?
  financialAccountId   String?
  settledTransactionId String?           @unique
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  carePerson         CarePerson        @relation(fields: [carePersonId], references: [id], onDelete: Restrict)
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)
  settledTransaction Transaction?      @relation(fields: [settledTransactionId], references: [id], onDelete: SetNull)
  lines              CareInvoiceLine[]

  @@index([status])
  @@index([carePersonId])
  @@map("care_invoices")
}

/// One priced sub-window of a coverage occurrence.
///
/// An occurrence yields more than one line when it straddles the boundary of
/// its assignee's typical schedule — e.g. a Fri 22:00 → Sat 08:00 window for
/// someone who works Mon–Fri bills the Friday part at the standard rate and
/// the Saturday part at the off-schedule rate. Occurrences that sit wholly
/// inside or wholly outside the schedule still produce exactly one line.
model CareInvoiceLine {
  id                 String       @id @default(uuid())
  invoiceId          String
  occurrenceId       String
  /// Priced sub-window. Equals the occurrence bounds when the window did not
  /// straddle a standard/off-schedule boundary.
  segmentStart       DateTime
  segmentEnd         DateTime
  rateBand           CareRateBand @default(STANDARD)
  amount             Decimal      @db.Decimal(19, 4)
  /// The rate charged (per hour or per day, per rateType)
  hourlyRateSnapshot Decimal      @db.Decimal(19, 4)
  /// Billable quantity: hours when HOURLY, days when DAILY
  hoursSnapshot      Decimal      @db.Decimal(19, 4)
  rateType           CareRateType @default(HOURLY)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  invoice    CareInvoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  occurrence CareCoverageOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)

  /// Replaces the old @unique on occurrenceId, which is what previously made
  /// invoice generation idempotent. Re-running generation for the same
  /// occurrence still cannot duplicate a segment.
  @@unique([invoiceId, occurrenceId, segmentStart])
  @@index([invoiceId])
  @@index([occurrenceId])
  @@map("care_invoice_lines")
}
