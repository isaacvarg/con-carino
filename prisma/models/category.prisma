model Category {
  id        String   @id @default(uuid())
  name      String
  iconId    String?
  bgColor   String?
  textColor String?
  /// See `Tag.archivedAt` — hidden from pickers, still resolved on history.
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  automations  Automation[]

  @@index([archivedAt])
  @@map("categories")
}
